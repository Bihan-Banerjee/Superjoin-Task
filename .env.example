# Copy to backend/.env (or export these) before running an ingest.
# Nothing here is required to browse the committed snapshot — only to process new PDFs.

# ---------------------------------------------------------------------------
# Language model provider
# ---------------------------------------------------------------------------
# One of: gemini | openrouter | ollama | replay
#   gemini      Google AI Studio. Default. Free tier is sufficient for this corpus.
#   openrouter  Any OpenAI-compatible model routed through openrouter.ai.
#   ollama      Fully local, no credentials. Slower and less accurate on dense prose.
#   replay      No network. Serves cached responses from backend/seed/replay/.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
# Extraction and adjudication are configured separately because quotas are per model.
# gemini-3-flash-preview reasons better but caps at 20 requests a day on the free tier, which
# is not enough to adjudicate a corpus; set it here if you have paid quota.
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_ADJUDICATION_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Output tokens the 2.5 models may spend reasoning before answering. Extraction always uses
# zero: it is a reading task, and reasoning drawn from the same budget truncates the JSON.
GEMINI_THINKING_BUDGET=1024

OPENROUTER_API_KEY=
OPENROUTER_EXTRACTION_MODEL=google/gemini-2.5-flash
OPENROUTER_ADJUDICATION_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

OLLAMA_HOST=http://localhost:11434
OLLAMA_EXTRACTION_MODEL=qwen2.5:14b-instruct
OLLAMA_ADJUDICATION_MODEL=qwen2.5:14b-instruct

# Fall back to this provider when the primary one errors or is rate limited.
# Leave empty to disable failover.
LLM_FALLBACK_PROVIDER=

# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------
# Concurrent in-flight model calls per ingest job.
# Requests per minute ceiling, applied across all workers. 0 disables throttling.
#
# These defaults sit inside the Gemini free tier (roughly 15 rpm on 2.5-flash). Raising
# them is fine on a paid key and the app will not stop you, but it warns at startup and on
# the Documents page when the settings look likely to be rate limited, because a run that
# spends its time absorbing 429s looks exactly like a slow model.
# Free-tier limits are per model and move often, so these are measured rather than quoted:
# gemini-3.1-flash-lite sustains this comfortably, while gemini-2.5-flash and
# gemini-3-flash-preview reject above 5 requests a minute and cap the day at 20.
#   free Gemini key : 15 / 3   (these defaults, on a flash-lite extraction model)
#   paid key        : 60 / 10
LLM_CONCURRENCY=3
LLM_RATE_LIMIT_RPM=15
# Adjudication uses a stronger model with a tighter quota, so it gets its own budget.
LLM_ADJUDICATION_RATE_LIMIT_RPM=12
# Send rendered page images for chart-heavy slides to a vision model.
ENABLE_VISION=true
# Adjudicate each ambiguous pair a second time with the two facts swapped, and keep the
# answer only if it survives. Doubles the cost of the smallest stage in the pipeline; the
# share of verdicts that changed is reported on the Evaluation page.
ADJUDICATION_CROSS_CHECK=true
# How much of a new document's substantive text must already be in the layer before it is
# flagged as repeating another document. Reported, never enforced.
NEAR_DUPLICATE_RATIO=0.9
# Cache model responses on disk keyed by prompt hash. Makes re-ingests nearly free.
LLM_CACHE_ENABLED=true
# Hard ceiling on model calls per ingest job. 0 disables the ceiling.
LLM_MAX_CALLS_PER_JOB=0

# Local ONNX embedding model used for candidate generation and registry linking.
# Downloaded once to ~/.cache on first run. No credentials involved.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ONNX threads for the embedding model. 0 chooses from the machine. Worth raising only if
# the registry stage dominates an ingest; past about eight it gets slower, not faster.
EMBEDDING_THREADS=0

# ---------------------------------------------------------------------------
# Storage and server
# ---------------------------------------------------------------------------
DATA_DIR=./data
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Processes used to parse PDF pages. 0 picks a sensible value from the machine.
PARSE_WORKERS=0
